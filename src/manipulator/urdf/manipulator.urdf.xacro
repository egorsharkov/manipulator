<?xml version="1.0"?>
<robot name="manipulator" xmlns:xacro="http://www.ros.org/wiki/xacro">
<xacro:arg name="use_control" default="false"/>
  <!-- ===== Размеры ===== -->
  <xacro:property name="base_r"     value="0.12"/>
  <xacro:property name="base_h"     value="0.1"/>
  <xacro:property name="shoulder_l" value="0.4"/>
  <xacro:property name="elbow_l"    value="0.3"/>
  <xacro:property name="finger_l"   value="0.15"/>

  <!-- ===== Макрос: звено-параллелепипед (стоит от начала координат вверх по z) ===== -->
  <xacro:macro name="box_link" params="name mass x y z rgba material">
    <link name="${name}">
      <visual>
        <origin xyz="0 0 ${z/2}"/>
        <geometry><box size="${x} ${y} ${z}"/></geometry>
        <material name="${material}"><color rgba="${rgba}"/></material>
      </visual>
      <collision>
        <origin xyz="0 0 ${z/2}"/>
        <geometry><box size="${x} ${y} ${z}"/></geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 ${z/2}"/>
        <mass value="${mass}"/>
        <inertia ixx="${mass/12*(y*y+z*z)}" ixy="0" ixz="0"
                 iyy="${mass/12*(x*x+z*z)}" iyz="0"
                 izz="${mass/12*(x*x+y*y)}"/>
      </inertial>
    </link>
  </xacro:macro>

  <!-- ===== Макрос: палец ===== -->
  <xacro:macro name="finger" params="side reflect lower upper">
    <xacro:box_link name="${side}_grip" mass="0.02" x="0.04" y="0.02"
                    z="${finger_l}" rgba="1 0 0 1" material="red_${side}"/>
    <joint name="${side}_grip_joint" type="revolute">
      <parent link="tool_link"/>
      <child link="${side}_grip"/>
      <origin xyz="0 ${reflect*0.06} 0"/>
      <axis xyz="1 0 0"/>
      <limit lower="${lower}" upper="${upper}" effort="20" velocity="1.0"/>
    </joint>
  </xacro:macro>

  <!-- ===== Основание ===== -->
  <link name="world"/>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 ${base_h/2}"/>
      <geometry><cylinder radius="${base_r}" length="${base_h}"/></geometry>
      <material name="blue"><color rgba="0.1 0.3 0.8 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 ${base_h/2}"/>
      <geometry><cylinder radius="${base_r}" length="${base_h}"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 ${base_h/2}"/>
      <mass value="2.0"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
    </inertial>
  </link>

  <joint name="base_joint" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
  </joint>

  <!-- ===== Плечо ===== -->
  <xacro:box_link name="shoulder_link" mass="0.8" x="0.08" y="0.08"
                  z="${shoulder_l}" rgba="1 0.4 0.05 1" material="orange"/>
  <joint name="shoulder_joint" type="revolute">
    <parent link="base_link"/>
    <child link="shoulder_link"/>
    <origin xyz="0 0 ${base_h}"/>
    <axis xyz="0 1 0"/>
    <limit lower="${-pi/2}" upper="${pi/2}" effort="20" velocity="1.0"/>
  </joint>

  <!-- ===== Предплечье ===== -->
  <xacro:box_link name="elbow_link" mass="0.5" x="0.06" y="0.06"
                  z="${elbow_l}" rgba="0.9 0.75 0.1 1" material="yellow"/>
  <joint name="elbow_joint" type="revolute">
    <parent link="shoulder_link"/>
    <child link="elbow_link"/>
    <origin xyz="0 0 ${shoulder_l}"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.0" upper="2.0" effort="15" velocity="1.0"/>
  </joint>

  <!-- ===== Крепление захвата ===== -->
  <link name="tool_link">
    <visual>
      <geometry><box size="0.06 0.12 0.06"/></geometry>
      <material name="grey"><color rgba="0.3 0.3 0.3 1"/></material>
    </visual>
    <collision>
      <geometry><box size="0.06 0.12 0.06"/></geometry>
    </collision>
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>
  <joint name="wrist_joint" type="revolute">
    <parent link="elbow_link"/>
    <child link="tool_link"/>
    <origin xyz="0 0 ${elbow_l}"/>
    <axis xyz="0 1 0"/>
    <limit lower="${-pi/2}" upper="${pi/2}" effort="5" velocity="1.0"/>
  </joint>

  <!-- ===== Два пальца одним макросом ===== -->
  <xacro:finger side="left"  reflect="1"  lower="0"    upper="0.3"/>
  <xacro:finger side="right" reflect="-1" lower="-0.3" upper="0"/>


  <xacro:macro name="pos_joint" params="name">
  <joint name="${name}">
    <command_interface name="position"/>
    <state_interface name="position"/>
    <state_interface name="velocity"/>
  </joint>
</xacro:macro>

<xacro:if value="$(arg use_control)">
<ros2_control name="GazeboSystem" type="system">
  <hardware>
    <plugin>gazebo_ros2_control/GazeboSystem</plugin>
  </hardware>
  <xacro:pos_joint name="shoulder_joint"/>
   <xacro:pos_joint name="elbow_joint"/>
  <xacro:pos_joint name="wrist_joint"/>
  <xacro:pos_joint name="left_grip_joint"/>
  <xacro:pos_joint name="right_grip_joint"/> 
</ros2_control>
<gazebo>
      <plugin name="gazebo_ros2_control" filename="libgazebo_ros2_control.so">
        <parameters>$(find manipulator)/config/controllers.yaml</parameters>
      </plugin>
    </gazebo>
  </xacro:if>
  <xacro:unless value="$(arg use_control)">
    <gazebo>
      <static>true</static>
    </gazebo>
  </xacro:unless>
</robot>
